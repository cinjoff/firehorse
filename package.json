{
  "name": "firehorse-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Firehorse monorepo — core lib + Pi package + Claude plugin.",
  "license": "MIT",
  "author": {
    "name": "cinjoff",
    "url": "https://github.com/cinjoff"
  },
  "homepage": "https://github.com/cinjoff/firehorse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinjoff/firehorse.git"
  },
  "bugs": {
    "url": "https://github.com/cinjoff/firehorse/issues"
  },
  "keywords": [
    "firehorse",
    "pi-package",
    "pi",
    "claude-code",
    "agentic",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./packages/firehorse-pi/extensions",
      "./node_modules/context-mode/build/adapters/pi/extension.js",
      "./node_modules/pi-lens/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/pi-mermaid/index.ts",
      "./node_modules/pi-subagents/src/extension/index.ts",
      "./node_modules/pi-web-access/index.ts",
      "./node_modules/pi-agent-memory/extensions"
    ],
    "skills": [
      "./node_modules/context-mode/skills/context-mode",
      "./node_modules/context-mode/skills/ctx-doctor",
      "./node_modules/context-mode/skills/ctx-insight",
      "./node_modules/context-mode/skills/ctx-stats",
      "./node_modules/pi-lens/skills/ast-grep",
      "./node_modules/pi-lens/skills/lsp-navigation",
      "./node_modules/pi-web-access/skills/librarian",
      "./node_modules/pi-subagents/skills/pi-subagents",
      "./node_modules/pi-agent-memory/skills/mem-search",
      "./packages/firehorse-pi/skills/firehorse-setup",
      "./packages/firehorse-pi/skills/mattpocock/engineering/diagnose",
      "./packages/firehorse-pi/skills/mattpocock/engineering/grill-with-docs",
      "./packages/firehorse-pi/skills/mattpocock/engineering/triage",
      "./packages/firehorse-pi/skills/mattpocock/engineering/improve-codebase-architecture",
      "./packages/firehorse-pi/skills/mattpocock/engineering/setup-matt-pocock-skills",
      "./packages/firehorse-pi/skills/mattpocock/engineering/tdd",
      "./packages/firehorse-pi/skills/mattpocock/engineering/to-issues",
      "./packages/firehorse-pi/skills/mattpocock/engineering/to-prd",
      "./packages/firehorse-pi/skills/mattpocock/engineering/zoom-out",
      "./packages/firehorse-pi/skills/mattpocock/engineering/prototype",
      "./packages/firehorse-pi/skills/mattpocock/productivity/caveman",
      "./packages/firehorse-pi/skills/mattpocock/productivity/grill-me",
      "./packages/firehorse-pi/skills/mattpocock/productivity/handoff",
      "./packages/firehorse-pi/skills/mattpocock/productivity/write-a-skill",
      "./packages/firehorse-pi/skills/shadcn-ui/shadcn",
      "./packages/firehorse-pi/skills/pbakaus/impeccable",
      "./packages/firehorse-pi/skills/firehorse/feedback-loop"
    ],
    "prompts": [
      "./packages/firehorse-pi/prompts",
      "./node_modules/pi-subagents/prompts",
      "./packages/firehorse-pi/prompts/firehorse/horse-diagnose-fix.md",
      "./packages/firehorse-pi/prompts/firehorse/horse-update-upstreams.md"
    ],
    "themes": [
      "./packages/firehorse-pi/themes"
    ]
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "typecheck": "pnpm definitions:check && pnpm -r --filter='./packages/*' typecheck",
    "test": "pnpm -r --filter='./packages/*' test",
    "format": "prettier --write .",
    "upstreams:check": "node scripts/check-upstreams.mjs",
    "upstreams:update:mattpocock-skills": "node scripts/update-mattpocock-skills.mjs",
    "upstreams:update:impeccable": "node scripts/update-impeccable-skills.mjs",
    "upstreams:update:shadcn-ui": "node scripts/update-shadcn-skill.mjs",
    "upstreams:write-update-manifests": "node scripts/write-update-manifests.mjs",
    "definitions:write": "tsx scripts/definitions.ts --write",
    "definitions:check": "tsx scripts/definitions.ts --check"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "context-mode": "1.0.134",
    "mermaid": "11.15.0",
    "pi-agent-memory": "0.3.4",
    "pi-lens": "3.8.44",
    "pi-mcp-adapter": "2.6.1",
    "pi-mermaid": "0.3.0",
    "pi-subagents": "0.24.2",
    "pi-web-access": "0.10.7"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  }
}
