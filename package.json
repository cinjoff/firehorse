{
  "name": "firehorse-workspace",
  "private": true,
  "version": "0.8.0",
  "description": "Firehorse monorepo — core lib + Claude plugin.",
  "license": "MIT",
  "author": {
    "name": "cinjoff",
    "url": "https://github.com/cinjoff"
  },
  "homepage": "https://github.com/cinjoff/firehorse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinjoff/firehorse.git"
  },
  "bugs": {
    "url": "https://github.com/cinjoff/firehorse/issues"
  },
  "keywords": [
    "firehorse",
    "claude-code",
    "agentic",
    "skills"
  ],
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "typecheck": "pnpm definitions:check && tsc --noEmit -p tsconfig.scripts.json && pnpm -r --filter=\"./packages/*\" typecheck",
    "test": "vitest run && pnpm -r --filter=\"./packages/*\" test",
    "format": "prettier --write .",
    "definitions:write": "tsx scripts/definitions.ts --write",
    "definitions:check": "tsx scripts/definitions.ts --check",
    "upstreams:check": "tsx scripts/upstreams.ts",
    "triage": "tsx scripts/triage.ts",
    "upstream-scan": "tsx scripts/upstream-scan.ts",
    "test:scripts": "vitest run"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "mermaid": "11.15.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2",
    "@types/node": "^22.7.4"
  }
}
