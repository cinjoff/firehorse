{
  "description": "Firehorse Claude plugin hooks: setup and update checks at SessionStart, the #253 next-action probe at Stop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check-setup.mjs"
            ],
            "timeout": 5,
            "statusMessage": "Checking Firehorse setup"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check-update.mjs"
            ],
            "timeout": 5,
            "statusMessage": "Checking Firehorse updates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/next-action-probe.mjs"
            ],
            "timeout": 5,
            "statusMessage": "Firehorse next-action probe (#253)"
          }
        ]
      }
    ]
  }
}
