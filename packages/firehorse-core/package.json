{
  "name": "firehorse",
  "version": "0.1.0",
  "description": "Lightweight, cross-provider agentic skills framework — core library.",
  "license": "MIT",
  "author": {
    "name": "cinjoff",
    "url": "https://github.com/cinjoff"
  },
  "homepage": "https://github.com/cinjoff/firehorse/tree/main/packages/firehorse-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinjoff/firehorse.git",
    "directory": "packages/firehorse-core"
  },
  "bugs": {
    "url": "https://github.com/cinjoff/firehorse/issues"
  },
  "keywords": [
    "firehorse",
    "agentic",
    "skills",
    "llm",
    "providers",
    "orchestrators"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./orchestrators": {
      "types": "./dist/orchestrators/index.d.ts",
      "import": "./dist/orchestrators/index.js",
      "require": "./dist/orchestrators/index.cjs"
    }
  },
  "files": [
    "dist",
    "upstreams",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
